<%- include("partials/header") %>

<section class="cadastro-page">

    <header class="cadastro-header">

        <p class="cadastro-label">
            MINHA BIBLIOTECA
        </p>

        <h1>
            Cadastrar Novo Livro
            <span>📚</span>
        </h1>

        <p>
            Adicione um novo livro à sua estante.
        </p>

    </header>


    <form action="/livros/novo" method="POST" class="cadastro-card">

        <fieldset>

            <legend>
                Informações do livro
            </legend>


            <section class="campo">

                <label for="titulo">
                    Título do Livro
                </label>

                <input
                    type="text"
                    id="titulo"
                    name="titulo"
                    placeholder="Ex.: Dom Casmurro"
                    required
                >

            </section>


            <section class="campo">

                <label for="autor">
                    Autor
                </label>

                <input
                    type="text"
                    id="autor"
                    name="autor"
                    placeholder="Ex.: Machado de Assis"
                    required
                >

            </section>


            <section class="campo">

                <label for="paginas">
                    Quantidade de Páginas
                </label>

                <input
                    type="number"
                    id="paginas"
                    name="paginas"
                    placeholder="Ex.: 250"
                    min="1"
                    required
                >

            </section>


            <menu class="form-buttons">

                <li>
                    <a href="/livros" class="cancelar">
                        Cancelar
                    </a>
                </li>

                <li>
                    <button type="submit">
                        Cadastrar Livro
                    </button>
                </li>

            </menu>

        </fieldset>

    </form>

</section>


<style>

    .cadastro-page {
        width: 90%;
        max-width: 850px;
        margin: auto;
        padding: 55px 0 80px;
    }

    .cadastro-header {
        margin-bottom: 35px;
    }

    .cadastro-label {
        color: #1769ed;
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 2px;
        margin-bottom: 10px;
    }

    .cadastro-header h1 {
        font-size: 42px;
        color: #17233d;
        margin-bottom: 10px;
    }

    .cadastro-header h1 span {
        font-size: 35px;
    }

    .cadastro-header p:last-child {
        color: #65728a;
        font-size: 17px;
    }


    .cadastro-card {
        background: white;
        padding: 40px;
        border-radius: 20px;

        box-shadow:
            0 10px 35px rgba(31, 56, 95, .09);
    }


    fieldset {
        border: none;
    }

    legend {
        font-size: 22px;
        font-weight: 800;
        color: #17233d;
        margin-bottom: 30px;
    }


    .campo {
        margin-bottom: 24px;
    }

    .campo label {
        display: block;
        font-size: 15px;
        font-weight: 700;
        color: #34415a;
        margin-bottom: 9px;
    }

    .campo input {
        width: 100%;
        height: 50px;

        padding: 0 15px;

        border: 1px solid #d8deea;
        border-radius: 10px;

        font-size: 16px;
        color: #17233d;

        outline: none;
    }

    .campo input:focus {
        border-color: #1769ed;

        box-shadow:
            0 0 0 3px rgba(23, 105, 237, .10);
    }


    .form-buttons {
        display: flex;
        justify-content: flex-end;
        gap: 12px;

        margin-top: 30px;

        list-style: none;
    }

    .cancelar {
        display: inline-block;

        padding: 14px 23px;

        border-radius: 10px;

        background: #eef1f6;
        color: #536079;

        font-weight: 700;
    }

    .cancelar:hover {
        background: #e1e5ec;
    }

    .form-buttons button {
        border: none;

        padding: 14px 23px;

        border-radius: 10px;

        background: #1769ed;
        color: white;

        font-size: 15px;
        font-weight: 700;

        cursor: pointer;

        box-shadow:
            0 8px 18px rgba(23, 105, 237, .20);
    }

    .form-buttons button:hover {
        background: #0f58ce;
    }


    @media (max-width: 600px) {

        .cadastro-page {
            width: 94%;
            padding-top: 35px;
        }

        .cadastro-header h1 {
            font-size: 32px;
        }

        .cadastro-card {
            padding: 25px 20px;
        }

        .form-buttons {
            flex-direction: column-reverse;
        }

        .form-buttons li,
        .form-buttons a,
        .form-buttons button {
            width: 100%;
            text-align: center;
        }
    }

</style>


<%- include("partials/footer") %>